<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundle's identity. `CFBundleExecutable` must match the file name in
	     Contents/MacOS/, which is the cargo binary's name. -->
	<key>CFBundleExecutable</key>
	<string>deepseek_balance</string>
	<key>CFBundleIdentifier</key>
	<string>com.quill.deepseek-balance</string>
	<key>CFBundleName</key>
	<string>DeepSeek Balance</string>
	<key>CFBundleDisplayName</key>
	<string>DeepSeek 余额</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- A status-bar app: no Dock icon, no app menu, nothing in Cmd-Tab.
	     The host also asks for `ActivationPolicy::Accessory` at runtime; this
	     keeps LaunchServices from showing a Dock icon during launch as well. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Draw into the backing store at native resolution instead of a scaled
	     low-res bitmap (the panel is a text-heavy layout). -->
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
</dict>
</plist>
